rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId}/children/{childId} {
      allow read: if familyId == 'little-ears-shared' && isValidChild(childId);
      allow write: if familyId == 'little-ears-shared'
        && isValidChild(childId);
    }

    function isValidChild(childId) {
      return childId == 'aadritha' || childId == 'aanya';
    }
  }
}
